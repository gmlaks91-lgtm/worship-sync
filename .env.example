# Copy to .env.local and fill in values.
# Never commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (npm run vapid:generate)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron /api/cron/daily-reminders
# Must match Authorization: Bearer <CRON_SECRET>
# Also set the same CRON_SECRET in Vercel Project → Settings → Environment Variables
CRON_SECRET=

# Apply pending DB migration (daily reminder columns) in Supabase SQL Editor:
#   supabase/migrations/20260609120000_profiles_daily_reminder.sql

# Optional
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=
NEXT_PUBLIC_SENTRY_DSN=
